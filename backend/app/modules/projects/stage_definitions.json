{
  "version": 1,
  "machine_version": 2,
  "description": "Seed data for the Project Management state machine, v2.0 (9-stage workflow per docs/modules/PROJECT_WORKFLOW_V2_SOP.md). Consumed by modules/projects/seed.py. On a tenant still on machine_version 1, the loader resets the definition collections before inserting these (see seed.py); fresh tenants seed straight to v2.",

  "foundational_phases": [
    {
      "key": "site_measurement_audit",
      "order": 1,
      "name": "Site Measurement Audit",
      "preceding_dependency": "Approved design package",
      "site_conditions": ["Physical/laser-scanned field measurements", "Substrate alignment, plumbness, structural soundness"],
      "downstream": "Freezes drawings against actual site dimensions before any material is cut.",
      "maps_to_stage_key": "measurement_verification"
    },
    {
      "key": "core_material_acclimation",
      "order": 2,
      "name": "Core Material Acclimation",
      "preceding_dependency": "Fabrication complete and delivered to site",
      "site_conditions": ["Ambient RH and temperature logging", "Moisture content testing of timber (target 6%-9%)"],
      "downstream": "Prevents premature installation; the Stage 8 timber-MC gate (G5) is the enforced check.",
      "maps_to_stage_key": "installation"
    },
    {
      "key": "site_prep_moisture_testing",
      "order": 3,
      "name": "Site Prep & Moisture Testing",
      "preceding_dependency": "Goods released from factory",
      "site_conditions": ["Subfloor flatness (max 1/4in over 10ft)", "Concrete RH profiling via in-situ probes (ASTM F2170)"],
      "downstream": "Locks installation if the subfloor is not ready; protects against adhesive failure/cupping/buckling.",
      "maps_to_stage_key": "site_readiness"
    }
  ],

  "gate_rules": [
    {
      "key": "deviation_within_tolerance",
      "type": "measurement",
      "blocking": true,
      "hard_gate": "G1",
      "attach_to_stages": ["measurement_verification"],
      "threshold": {"max_deviation_mm": 3.0, "unit": "mm"},
      "severe_threshold": {"max_deviation_mm": 6.0, "unit": "mm", "on_fail": "return_to_stage"},
      "note": "G1. Point of no return — material is cut after this. ≤3mm acceptable, >6mm severe returns the project to Stage 3 for redesign."
    },
    {
      "key": "concrete_rh_astm_f2170",
      "type": "measurement",
      "blocking": true,
      "hard_gate": "G3",
      "attach_to_stages": ["site_readiness"],
      "phase_ref": "site_prep_moisture_testing",
      "threshold": {"max_rh_pct": 75, "method": "ASTM F2170", "configurable": true},
      "note": "G3. Warranty-bearing. In-situ probe, not surface. Default 75% RH; final limit set by the flooring/adhesive manufacturer per tenant."
    },
    {
      "key": "subfloor_flatness",
      "type": "measurement",
      "blocking": true,
      "hard_gate": "G4",
      "attach_to_stages": ["site_readiness"],
      "phase_ref": "site_prep_moisture_testing",
      "threshold": {"max_deviation_in": 0.25, "over_ft": 10},
      "note": "G4. The #1 cause of rework. Max 1/4in deviation over 10ft."
    },
    {
      "key": "timber_moisture_content",
      "type": "measurement",
      "blocking": true,
      "hard_gate": "G5",
      "attach_to_stages": ["installation"],
      "phase_ref": "core_material_acclimation",
      "threshold": {"min": 6, "max": 9, "unit": "%"},
      "note": "G5. Warranty-bearing. Timber MC must sit within range before laying begins."
    },
    {
      "key": "substrate_soundness",
      "type": "inspection",
      "blocking": false,
      "attach_to_stages": ["site_survey", "site_readiness"],
      "checklist": [
        "Substrate structurally sound",
        "No delamination or defects",
        "Surface clean and dry",
        "Alignment and plumbness within tolerance"
      ],
      "note": "Logged, not blocking (v2.0). Recorded in the Stage 2 findings register; the Stage 7 reading is the one that counts."
    },
    {
      "key": "ambient_rh_temp_log",
      "type": "measurement",
      "blocking": false,
      "attach_to_stages": ["installation"],
      "phase_ref": "core_material_acclimation",
      "threshold": {"site_defined": true},
      "note": "Logged, not blocking (v2.0). Passive daily log during install — honest data for a dispute, not a mid-work blocker."
    },
    {
      "key": "fixing_channel_alignment",
      "type": "inspection",
      "blocking": false,
      "attach_to_stages": ["final_inspection_handover"],
      "checklist": [
        "Aluminum channels level within tolerance",
        "Channels plumb within tolerance",
        "Clip spacing per shop drawing",
        "Anchorage secure"
      ],
      "note": "Logged, not blocking (v2.0). Workmanship criterion assessed on the finished surface at Stage 9 as a snag."
    },
    {
      "key": "reveal_gap_3mm",
      "type": "measurement",
      "blocking": false,
      "attach_to_stages": ["final_inspection_handover"],
      "threshold": {"target_mm": 3, "tolerance_mm": 1, "unit": "mm"},
      "note": "Logged, not blocking (v2.0). Assessed on the finished surface at Stage 9 as a snag."
    }
  ],

  "report_types": [
    {"type": "missing_information", "label": "Missing Information Report", "raised_at_stages": ["project_initiation"]},
    {"type": "issue", "label": "Issue Report", "raised_at_stages": ["measurement_verification", "installation", "*"]},
    {"type": "change", "label": "Change Report / Variation Order", "raised_at_stages": ["*"]},
    {"type": "ncr", "label": "Non-Conformance Report", "raised_at_stages": ["factory_release"]},
    {"type": "capa", "label": "Corrective & Preventive Action", "raised_at_stages": ["final_inspection_handover"]},
    {"type": "rfi", "label": "Request for Information", "raised_at_stages": ["installation"]},
    {"type": "qa", "label": "Quality Assurance Report", "raised_at_stages": ["final_inspection_handover"]},
    {"type": "na", "label": "Snag / Non-Applicable", "raised_at_stages": ["final_inspection_handover"]}
  ],

  "approver_role_map": [
    {"approver_role": "project_director", "client_roles": ["owner"], "assigned_user_ids": []},
    {"approver_role": "design_manager", "client_roles": ["owner"], "assigned_user_ids": []},
    {"approver_role": "engineering", "client_roles": ["owner"], "assigned_user_ids": []},
    {"approver_role": "procurement_manager", "client_roles": ["owner"], "assigned_user_ids": []},
    {"approver_role": "production_manager", "client_roles": ["owner"], "assigned_user_ids": []},
    {"approver_role": "project_manager", "client_roles": ["owner"], "assigned_user_ids": []}
  ],

  "stage_definitions": [
    {
      "order": 1,
      "key": "project_initiation",
      "name": "Project Initiation",
      "phase_ref": null,
      "entry_gates": [
        {"key": "loi_or_po", "type": "document", "blocking": true},
        {"key": "scope_boq_approved", "type": "document", "blocking": true},
        {"key": "site_access_confirmed", "type": "document", "blocking": true}
      ],
      "automated_tasks": ["create_project_record", "assign_core_team", "log_client_requirements", "confirm_commercial_terms"],
      "quality_gates": [],
      "approver_role": "project_director",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [{"module": "crm", "action": "link_account"}],
      "recovery": {"on": "missing_docs", "action": "hold_and_notify", "target": "sales", "state": "waiting", "note": "Prevent initiation until the 3 required documents are supplied."},
      "is_active": true
    },
    {
      "order": 2,
      "key": "site_survey",
      "name": "Site Survey & Technical Assessment",
      "phase_ref": null,
      "auto_advance": true,
      "entry_gates": [
        {"key": "initiation_approved", "type": "dependency", "depends_on": "project_initiation", "blocking": true}
      ],
      "automated_tasks": ["dimensional_survey", "substrate_observation", "services_and_level_check", "access_and_logistics_assessment"],
      "quality_gates": ["substrate_soundness"],
      "approver_role": null,
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [],
      "recovery": {"on": "incomplete_survey", "action": "generate_report", "report_type": "issue", "state": "waiting", "note": "No separate approval or gate — auto-advances on completion; its output feeds the design package."},
      "is_active": true
    },
    {
      "order": 3,
      "key": "design_package",
      "name": "Design Package",
      "phase_ref": null,
      "entry_gates": [
        {"key": "survey_complete", "type": "dependency", "depends_on": "site_survey", "blocking": true}
      ],
      "automated_tasks": ["concept_design", "material_selection", "specification", "shop_drawings"],
      "quality_gates": [],
      "approver_role": "design_manager",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [{"module": "inventory", "action": "check_availability"}],
      "recovery": {"on": "rejection", "action": "record_comments_generate_v2", "target": "design_package", "state": "rejected", "note": "Concept, material and shop drawings approved as one package; a material that is unavailable or over budget is resolved here, not in a second queue."},
      "is_active": true
    },
    {
      "order": 4,
      "key": "measurement_verification",
      "name": "Measurement Verification & Design Freeze",
      "phase_ref": "site_measurement_audit",
      "entry_gates": [
        {"key": "shop_drawings_present", "type": "document", "blocking": true},
        {"key": "raw_site_data_present", "type": "document", "blocking": true}
      ],
      "automated_tasks": ["import_as_built_measurements", "compare_against_drawings", "detect_deviations", "freeze_design"],
      "quality_gates": ["deviation_within_tolerance"],
      "approver_role": "engineering",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [],
      "recovery": {"on": "severe_deviation", "action": "return_to_stage", "target": "design_package", "state": "rejected", "note": "G1. Point of no return. A severe deviation (>6mm) returns the project to Stage 3 for redesign — not a verbal pass. After freeze, any change is a Variation Order."},
      "is_active": true
    },
    {
      "order": 5,
      "key": "material_procurement",
      "name": "Material Procurement",
      "phase_ref": null,
      "entry_gates": [
        {"key": "design_frozen", "type": "dependency", "depends_on": "measurement_verification", "blocking": true},
        {"key": "bom_present", "type": "document", "blocking": true}
      ],
      "automated_tasks": ["finalise_bom", "confirm_supplier_lead_times", "raise_purchase_orders", "reserve_stock", "confirm_delivery_window"],
      "quality_gates": [],
      "approver_role": "procurement_manager",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [
        {"module": "inventory", "action": "reserve_stock"},
        {"module": "finance", "action": "record_commitment"}
      ],
      "recovery": {"on": "supplier_delay", "action": "split_procurement_adjust_schedule", "state": "in_progress", "note": "G2. Approval reserves BOM stock via Inventory."},
      "is_active": true
    },
    {
      "order": 6,
      "key": "factory_release",
      "name": "Factory Release",
      "phase_ref": null,
      "entry_gates": [
        {"key": "materials_reserved", "type": "dependency", "depends_on": "material_procurement", "blocking": true}
      ],
      "automated_tasks": ["production", "quality_control", "packing_protection", "delivery_planning"],
      "release_checklist": ["production", "quality_control", "packing_protection", "delivery_planning"],
      "quality_gates": [],
      "approver_role": "production_manager",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [
        {"module": "inventory", "action": "consume_stock"},
        {"module": "finance", "action": "post_job_costs"}
      ],
      "recovery": {"on": "release_failure", "action": "rework_or_repackage", "state": "in_progress", "note": "Four sequential v1.0 approvals became one release decision; all four checklist sections must be complete before release."},
      "is_active": true
    },
    {
      "order": 7,
      "key": "site_readiness",
      "name": "Site Readiness Inspection",
      "phase_ref": "site_prep_moisture_testing",
      "entry_gates": [
        {"key": "goods_released", "type": "dependency", "depends_on": "factory_release", "blocking": true}
      ],
      "automated_tasks": ["concrete_rh_test", "subfloor_flatness_check", "verify_access_storage_safety"],
      "quality_gates": ["concrete_rh_astm_f2170", "subfloor_flatness", "substrate_soundness"],
      "approver_role": "project_manager",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [],
      "recovery": {"on": "site_not_ready", "action": "generate_punch_list_notify_client", "state": "on_hold", "note": "No crew mobilises before this is approved. A failed inspection is a client conversation with a revised date, not a reason to start anyway."},
      "is_active": true
    },
    {
      "order": 8,
      "key": "installation",
      "name": "Installation",
      "phase_ref": "core_material_acclimation",
      "entry_gates": [
        {"key": "site_readiness_cleared", "type": "dependency", "depends_on": "site_readiness", "blocking": true}
      ],
      "automated_tasks": ["verify_timber_moisture", "install_and_align", "compile_daily_log"],
      "quality_gates": ["timber_moisture_content", "ambient_rh_temp_log"],
      "approver_role": "project_manager",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [],
      "recovery": {"on": "installation_issue", "action": "pause_zone_generate_issue_report", "report_type": "issue", "state": "on_hold", "note": "G5. Channel alignment and 3mm reveal are no longer install gates — they are assessed on the finished surface at Stage 9 as snags."},
      "is_active": true
    },
    {
      "order": 9,
      "key": "final_inspection_handover",
      "name": "Final Inspection & Client Handover",
      "phase_ref": null,
      "entry_gates": [
        {"key": "installation_completed", "type": "dependency", "depends_on": "installation", "blocking": true}
      ],
      "automated_tasks": ["snag_inspection", "close_snags", "generate_handover_pack", "generate_final_invoice"],
      "quality_gates": ["fixing_channel_alignment", "reveal_gap_3mm"],
      "approver_role": "project_director",
      "co_approver_roles": [],
      "conditional_approvers": [],
      "integrations": [{"module": "finance", "action": "issue_final_invoice"}],
      "recovery": {"on": "inspection_failure", "action": "generate_capa_assign_rework", "report_type": "capa", "target": "final_inspection_handover", "state": "rejected", "note": "Snags closed before handover; an open snag does not proceed without written client acceptance. Terminal state on approve — handover pack built automatically."},
      "is_active": true
    }
  ]
}
