# ERP backend configuration — copy to .env and adjust.
# Load precedence: real environment variables > .env > defaults in app/core/config.py
# NEVER commit a real .env. Production values are injected secrets (see docs/ENVIRONMENTS.md).

# Environment: local | test | production
ERP_ENV=local

# Mongo
ERP_MONGO_URI=mongodb://localhost:27017
ERP_CONTROL_DB_NAME=erp_control
ERP_TENANT_DB_PREFIX=erp_tenant_

# Auth — REQUIRED: set a real secret (e.g. `openssl rand -hex 32`)
ERP_JWT_SECRET=change-me-dev-only
ERP_JWT_ALGORITHM=HS256
ERP_ACCESS_TOKEN_TTL_MIN=60
ERP_REFRESH_TOKEN_TTL_DAYS=14
ERP_ADMIN_TOKEN_AUDIENCE=erp-admin
ERP_CLIENT_TOKEN_AUDIENCE=erp-client

# Security defaults (overridable per company)
ERP_DEFAULT_FAILED_LOGIN_THRESHOLD=5
ERP_DEFAULT_LOCKOUT_MINUTES=15

# Rate limiting (lenient in local; strict + Mongo-backed in production)
ERP_RATE_LIMIT_ENABLED=true
ERP_RATE_LIMIT_WINDOW_SEC=60
ERP_RATE_LIMIT_MAX_REQUESTS=120

# IP access control (docs/IP_ACCESS_CONTROL_PLAN.md). ENABLED is the break-glass
# kill switch: false bypasses all IP filtering. TRUSTED_PROXIES (JSON list of
# IPs/CIDRs) are the only peers whose X-Forwarded-For is trusted for the real
# client IP; empty = trust none (use the socket peer). RULE_CACHE_TTL_SEC is how
# long a compiled ruleset is served in-process before reload — the cross-worker
# propagation delay for an admin rule change. GEOIP_DB_PATH points at a
# self-hosted MaxMind-format country DB (.mmdb; GeoLite2 Country or DB-IP Lite);
# unset = country rules inert (never an external API call).
ERP_IP_FILTER_ENABLED=true
ERP_IP_TRUSTED_PROXIES=[]
ERP_IP_RULE_CACHE_TTL_SEC=10
# ERP_IP_GEOIP_DB_PATH=/etc/erp/geoip/country.mmdb

# CORS — exact frontend origin(s), JSON list
ERP_CORS_ORIGINS=["http://localhost:5173"]

# Platform metrics collector loop interval (seconds); 0 disables it.
ERP_METRICS_INTERVAL_SEC=300

# --- Production notes (docs/ENVIRONMENTS.md §4) -------------------------------
# With ERP_ENV=production the app fails fast at startup unless:
#   * ERP_JWT_SECRET is a strong injected secret (>= 32 chars, not a dev value)
#   * ERP_CORS_ORIGINS is the real frontend origin(s), never localhost
#   * ERP_MONGO_URI is the injected replica-set URI, never localhost
# Production also disables /docs and emits structured JSON logs, and the rate
# limiter uses the Mongo-backed store so the limit holds across workers.
