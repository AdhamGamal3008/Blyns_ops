# Production configuration (docs/DEPLOYMENT_PLAN.md Phase E, ENVIRONMENTS.md §4).
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# NEVER commit the filled-in file. Generate every secret ON THE SERVER — a secret
# that travels through chat, email or a laptop clipboard is already compromised.
#
# With ERP_ENV=production the app REFUSES TO START unless the JWT secret is strong,
# /docs is off, CORS names a real origin, and the Mongo URI is not localhost. That
# is deliberate: a misconfigured production process fails loudly at boot instead of
# serving quietly with a dev secret (core/config.py validate_for_production).

# --- identity -----------------------------------------------------------------
# The domain Caddy issues a certificate for, without scheme. Apex only; the
# Caddyfile adds www automatically.
ERP_DOMAIN=example.com

# Image to run. Use a SHA-tagged image so a deploy is reproducible and a rollback
# is just re-pointing this at the previous tag.
ERP_IMAGE=ghcr.io/adhamgamal3008/blyns-erp:latest

# --- app ----------------------------------------------------------------------
# Load-bearing: flips the rate limiter to the Mongo-backed store (so the limit
# holds across all 4 workers), disables /docs, switches to structured JSON logs,
# and turns on the startup safety check.
ERP_ENV=production

# REQUIRED, >= 32 chars, not a known dev value. Generate on the server:
#   openssl rand -hex 32
# Rotating this invalidates every issued token — everyone is logged out at once.
ERP_JWT_SECRET=

ERP_ACCESS_TOKEN_TTL_MIN=15
ERP_REFRESH_TOKEN_TTL_DAYS=14

# Exact frontend origin(s), JSON list. Must not be localhost. Same-origin serving
# means CORS is never actually exercised, but the startup check requires it set.
ERP_CORS_ORIGINS=["https://example.com","https://www.example.com"]

# --- database -----------------------------------------------------------------
# Credentials for the container's root user, consumed by mongo on FIRST BOOT only.
# Generate both:  openssl rand -hex 24
MONGO_ROOT_USER=erproot
MONGO_ROOT_PASSWORD=

# The least-privilege user the app actually connects as (see
# deploy/mongo-init/01-init-replica-set.js).
MONGO_APP_USER=erpapp
MONGO_APP_PASSWORD=

# Must match MONGO_APP_USER / MONGO_APP_PASSWORD above. `mongo` is the compose
# service name; the database is never published to the host.
ERP_MONGO_URI=mongodb://erpapp:CHANGEME@mongo:27017/?replicaSet=rs0&authSource=admin

ERP_CONTROL_DB_NAME=erp_control
ERP_TENANT_DB_PREFIX=erp_tenant_

# --- behind the reverse proxy -------------------------------------------------
# CRITICAL (docs/DEPLOYMENT_PLAN.md §3 gap #4, G-2). Only proxies listed here are
# trusted to carry the real client IP in X-Forwarded-For. Leave it empty and every
# request appears to come from Caddy, so ALL USERS SHARE ONE RATE-LIMIT BUCKET —
# one noisy client can rate-limit everybody — and IP allow/deny rules match the
# proxy rather than the visitor.
#
# Use the compose network's subnet. Find it after first start with:
#   docker network inspect blyns_ops_internal -f '{{(index .IPAM.Config 0).Subnet}}'
ERP_IP_TRUSTED_PROXIES=["172.16.0.0/12"]

ERP_IP_FILTER_ENABLED=true
# Bootstrap your own office/home IPs onto the allowlist so a bad rule can never
# lock every admin out. Seeded in production only, by seed_control_plane.py.
ERP_IP_SEED_ALLOW_IPS=[]
# ISO 3166-1 alpha-2 country codes to deny. A compliance decision you own —
# nothing is baked in, and country rules stay inert without a .mmdb dataset.
ERP_IP_SEED_DENY_COUNTRIES=[]

# --- limits -------------------------------------------------------------------
ERP_RATE_LIMIT_ENABLED=true
ERP_RATE_LIMIT_WINDOW_SEC=60
ERP_RATE_LIMIT_MAX_REQUESTS=120

# Project document uploads live in GridFS inside each tenant's own database, so
# these grow the Mongo volume directly — watch disk (Phase F).
ERP_MAX_UPLOAD_MB=25
ERP_MAX_IMPORT_MB=5
ERP_MAX_IMPORT_ROWS=5000

ERP_METRICS_INTERVAL_SEC=300

# --- must stay OFF ------------------------------------------------------------
# The demo gate is for temporary public sharing over a tunnel. In production it
# would put an HTTP Basic prompt in front of your real customers.
# DEMO_GATE_ENABLED=
