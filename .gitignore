# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/

# Env & secrets — never commit real config
.env
.env.local
.env.production
.env.demo
.demo-backend.log

# MongoDB replica-set keyfile — a shared secret, generated per deployment by
# scripts/init_mongo_keyfile.sh. Never commit it.
deploy/mongo-keyfile

# Backups may contain every tenant's data — never let them into the repo.
backups/

# EXCEPTION: frontend/.env.production is build-time PUBLIC config, not a secret —
# anything in a VITE_ var is compiled into the bundle the browser downloads, so it
# can never hold one. It must be tracked: without it `npm run build` leaves
# VITE_API_BASE undefined and the SPA falls back to http://localhost:8000/api/v1,
# which means every visitor's browser calls its own machine instead of the server.
!frontend/.env.production

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json
